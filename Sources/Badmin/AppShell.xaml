<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="Badmin.AppShell"
	   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	   xmlns:views="clr-namespace:Badmin.Views"
	   Title="bAdmin">
	<TabBar>
		<Tab Title="Table">
			<ShellContent ContentTemplate="{DataTemplate views:TableView}"/>
		</Tab>
		<Tab Title="Session">
			<ShellContent ContentTemplate="{DataTemplate views:SessionView}"/>
		</Tab>
		<Tab Title="Players">
			<ShellContent ContentTemplate="{DataTemplate views:PlayersView}"/>
		</Tab>
	</TabBar>
</Shell>
